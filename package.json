{
  "name": "mindspace-dsh-local-rag",
  "version": "0.3.7",
  "description": "Local, model-invoked hybrid RAG for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "Spirtxiaoqi7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spirtxiaoqi7/mindspace-dsh-local-rag.git"
  },
  "homepage": "https://github.com/Spirtxiaoqi7/mindspace-dsh-local-rag#readme",
  "bugs": "https://github.com/Spirtxiaoqi7/mindspace-dsh-local-rag/issues",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "rag",
    "local-rag",
    "hybrid-search",
    "arpm",
    "bm25",
    "vector-search"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.js",
    "./remote": "./lib/remote.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/verify-runtime-deps.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/normalize-build.mjs",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run test && pnpm pack --pack-destination dist"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@huggingface/transformers": "^4.2.0",
    "mammoth": "^1.12.1",
    "onnxruntime-node": "1.24.3",
    "pdfjs-dist": "^6.2.108",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-home-paths": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.28",
    "jszip": "^3.10.1",
    "lightningcss": "^1.32.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
